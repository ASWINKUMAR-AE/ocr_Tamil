# Server Network Configuration
HOST=0.0.0.0
PORT=8000
AUTO_DETECT_LAN_IP=true

# OCR Engine Configuration
ENABLE_CUDA=false
MAX_CONCURRENT_OCR=2

# Security & Limits
# Set API_KEY to enable authentication (e.g. API_KEY=secret-token-123). Leave blank to disable.
API_KEY=
MAX_UPLOAD_SIZE_MB=15
MAX_IMAGE_DIMENSION=4096
MAX_BATCH_SIZE=10

# CORS Configuration (comma-separated or * for LAN development)
CORS_ORIGINS=*

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
